from typing import Callable
class TokenFoldError(Exception): ...
class InvalidInputError(TokenFoldError): ...
class SafetyError(TokenFoldError): ...
class ConfigError(TokenFoldError): ...
class InternalError(TokenFoldError): ...
class AccountingError(TokenFoldError): ...
class BusyError(TokenFoldError): ...
class ClosedError(TokenFoldError): ...
class ScorerError(TokenFoldError): ...
class CancelledError(TokenFoldError): ...
class CancellationToken:
    def __init__(self) -> None: ...
    def cancel(self) -> None: ...
    @property
    def cancelled(self) -> bool: ...
class _Fit:
    def step(self, count: str | None = None, counter_id: str | None = None) -> str: ...
    def wait_score(self) -> None: ...
    def on_score(self, callback: Callable[[], object]) -> None: ...
class _Client:
    def __init__(self, select: str | None = None, max_pending_scores: int = 32, score_wait_timeout_ms: int = 5000) -> None: ...
    def begin(self, source: str, target: int, mode: str, allow_selection: bool, counter_kind: str, counter_value: str, cancel: CancellationToken) -> _Fit: ...
    def warmup(self) -> None: ...
    def close(self) -> None: ...
def receipt_json(source: str) -> str: ...
def counter_id(kind: str, value: str) -> str: ...
def count(kind: str, value: str, format: str, scope: str, payload: str) -> str: ...
