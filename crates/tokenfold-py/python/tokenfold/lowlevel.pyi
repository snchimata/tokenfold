from typing import ClassVar
from os import PathLike
from .types import JsonObject, JsonValue
from ._native import (TokenFoldError as TokenFoldError, InvalidInputError as InvalidInputError,
    SafetyError as SafetyError, ConfigError as ConfigError, InternalError as InternalError)
class EstimatorError(TokenFoldError): ...
class RetrievalError(TokenFoldError): ...
class BudgetUnmetError(TokenFoldError):
    receipt: CompressionReport
class Preset:
    CONSERVATIVE: ClassVar[Preset]
    BALANCED: ClassVar[Preset]
    AGGRESSIVE: ClassVar[Preset]
class InputFormat:
    AUTO: ClassVar[InputFormat]
    OPENAI_JSON: ClassVar[InputFormat]
    ANTHROPIC_JSON: ClassVar[InputFormat]
    JSON: ClassVar[InputFormat]
    PLAIN_TEXT: ClassVar[InputFormat]
    COMMAND_OUTPUT: ClassVar[InputFormat]
    GIT_DIFF: ClassVar[InputFormat]
class Encoding:
    JSON: ClassVar[Encoding]
    TOON: ClassVar[Encoding]
class Status:
    COMPRESSED: ClassVar[Status]
    PASSTHROUGH: ClassVar[Status]
class PruningPolicy:
    def __init__(self, keep_ratio: float | None = None, preserve_paths: list[str] | None = None, retrieval_store: str | PathLike[str] | None = None, retrieval_namespace: str | None = None) -> None: ...
    @property
    def keep_ratio(self) -> float | None: ...
    @property
    def preserve_paths(self) -> list[str]: ...
class EstimatorInfo:
    @property
    def backend(self) -> str: ...
    @property
    def model(self) -> str | None: ...
    @property
    def is_exact(self) -> bool: ...
class CompressionReport:
    @property
    def schema_version(self) -> str: ...
    @property
    def original_tokens(self) -> int: ...
    @property
    def compressed_tokens(self) -> int: ...
    @property
    def saved_tokens(self) -> int: ...
    @property
    def savings_ratio(self) -> float: ...
    @property
    def savings_pct(self) -> float: ...
    @property
    def estimator(self) -> EstimatorInfo: ...
    @property
    def status(self) -> Status: ...
    @property
    def preset(self) -> str: ...
    @property
    def format(self) -> str: ...
    @property
    def task_scope(self) -> str: ...
    @property
    def warnings(self) -> list[str]: ...
    @property
    def raw(self) -> JsonObject: ...
class CompressionResult:
    @property
    def payload(self) -> bytes: ...
    @property
    def report(self) -> CompressionReport: ...
    @property
    def text(self) -> str: ...
    def saved_pct(self) -> float: ...
def compress(payload: str | bytes, *, format: InputFormat | str | None = None, preset: Preset | str | None = None, target_tokens: int | None = None, require_target: bool = False, encoding: Encoding | str | None = None, pruning: PruningPolicy | None = None, retrieval_max_store_bytes: int | None = None) -> CompressionResult: ...
def inspect(payload: str | bytes, *, format: InputFormat | str | None = None, preset: Preset | str | None = None, target_tokens: int | None = None, require_target: bool = False, encoding: Encoding | str | None = None, pruning: PruningPolicy | None = None, retrieval_max_store_bytes: int | None = None) -> CompressionReport: ...
def decode(payload: str | bytes, *, from_format: str = "auto") -> bytes: ...
def retrieve(reference: str | JsonValue, *, retrieval_store: str | PathLike[str] | None = None, namespace: str | None = None) -> bytes: ...
def parse_report(data: bytes) -> CompressionReport: ...
