{
  "name": "tokenfold",
  "version": "0.5.4",
  "description": "Native in-process token budget fitting for text and provider requests.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snchimata/tokenfold.git",
    "directory": "packages/tokenfold"
  },
  "homepage": "https://github.com/snchimata/tokenfold#readme",
  "bugs": "https://github.com/snchimata/tokenfold/issues",
  "keywords": [
    "llm",
    "tokens",
    "token-optimization",
    "compression",
    "tokenizer",
    "cli",
    "openai",
    "json",
    "prompt-engineering",
    "mcp",
    "proxy",
    "context-window"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tokenfold": "./bin/tokenfold.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:types && node --test test/*.test.mjs ../../scripts/*.test.mjs",
    "prepack": "npm run build",
    "build:native": "node ../../scripts/build-native.mjs",
    "test:types": "tsc --noEmit --strict --target ES2022 --lib ES2024 --module NodeNext --moduleResolution NodeNext test/fit-types.ts"
  },
  "optionalDependencies": {
    "@tokenfold/cli-darwin-x64": "0.5.4",
    "@tokenfold/cli-darwin-arm64": "0.5.4",
    "@tokenfold/cli-linux-x64": "0.5.4",
    "@tokenfold/cli-linux-arm64": "0.5.4",
    "@tokenfold/cli-win32-x64": "0.5.4",
    "@tokenfold/native-darwin-x64": "0.5.4",
    "@tokenfold/native-darwin-arm64": "0.5.4",
    "@tokenfold/native-linux-x64": "0.5.4",
    "@tokenfold/native-linux-arm64": "0.5.4",
    "@tokenfold/native-win32-x64": "0.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
